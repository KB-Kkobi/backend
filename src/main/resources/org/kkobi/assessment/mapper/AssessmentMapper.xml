<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.kkobi.assessment.mapper.AssessmentMapper">

    <select id="getLatestAssessmentScore"
            resultType="org.kkobi.assessment.domain.AssessmentScore">
        SELECT
            rt_score,
            lh_score,
            rp_score
        FROM results
        WHERE user_id = #{userId}
        ORDER BY created_at DESC, result_id DESC
        LIMIT 1
    </select>

    <select id="getLatestAssessmentResultDetails"
            resultType="org.kkobi.assessment.domain.AssessmentResultDetails">
        SELECT
            r.result_id,
            p.axis_code,
            p.persona_name,
            p.description,
            p.feature,
            p.strength,
            p.caution,
            r.rt_score,
            r.lh_score,
            r.rp_score,
            p.stock_ratio,
            p.bond_ratio,
            p.deposit_ratio,
            r.created_at AS analyzed_at
        FROM results r
        JOIN personas p
          ON p.persona_id = r.persona_id
        WHERE r.user_id = #{userId}
        ORDER BY r.created_at DESC, r.result_id DESC
        LIMIT 1
    </select>

    <resultMap id="assessmentResultMap"
               type="org.kkobi.assessment.dto.AssessmentResultResponseDto">
        <id property="resultId" column="result_id" />
        <result property="userId" column="user_id" />
        <result property="rtScore" column="rt_score" />
        <result property="lhScore" column="lh_score" />
        <result property="rpScore" column="rp_score" />
        <association property="persona" javaType="org.kkobi.persona.dto.PersonaResponseDto">
            <id property="personaId" column="persona_id" />
            <result property="personaName" column="persona_name" />
            <result property="axisCode" column="axis_code" />
            <result property="imagePath" column="image_path" />
            <result property="description" column="description" />
            <result property="feature" column="feature" />
            <result property="strength" column="strength" />
            <result property="caution" column="caution" />
            <result property="reasonTitle" column="reason_title" />
            <result property="reasonPrefix" column="reason_prefix" />
            <result property="reasonHighlight" column="reason_highlight" />
            <result property="reasonSuffix" column="reason_suffix" />
            <result property="reasonSummary" column="reason_summary" />
            <result property="portfolioReasonFirst" column="portfolio_reason_first" />
            <result property="portfolioReasonSecond" column="portfolio_reason_second" />
            <result property="stockRatio" column="stock_ratio" />
            <result property="bondRatio" column="bond_ratio" />
            <result property="depositRatio" column="deposit_ratio" />
        </association>
    </resultMap>

    <select id="getLatestAssessmentResult" resultMap="assessmentResultMap">
        SELECT
            r.result_id,
            r.user_id,
            r.rt_score,
            r.lh_score,
            r.rp_score,
            p.persona_id,
            p.persona_name,
            p.axis_code,
            p.image_path,
            p.description,
            p.feature,
            p.strength,
            p.caution,
            p.reason_title,
            p.reason_prefix,
            p.reason_highlight,
            p.reason_suffix,
            p.reason_summary,
            p.portfolio_reason_first,
            p.portfolio_reason_second,
            p.stock_ratio,
            p.bond_ratio,
            p.deposit_ratio
        FROM results r
        JOIN personas p ON p.persona_id = r.persona_id
        WHERE r.user_id = #{userId}
        ORDER BY r.result_id DESC
        LIMIT 1
    </select>

    <select id="getPersonaIdByAxisCode" resultType="java.lang.Long">
        SELECT persona_id
        FROM personas
        WHERE axis_code = #{axisCode}
        ORDER BY persona_id
        LIMIT 1
    </select>

    <insert id="saveAssessmentResult">
        INSERT INTO results (
            user_id,
            persona_id,
            rt_score,
            lh_score,
            rp_score
        )
        VALUES (
            #{userId},
            #{personaId},
            #{score.rtScore},
            #{score.lhScore},
            #{score.rpScore}
        )
    </insert>
</mapper>
