<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.kkobi.users.mapper.UserMapper">
    <!-- users 테이블 컬럼을 UserVO 필드에 매핑 -->
    <resultMap id="userMap" type="UserVO">
        <id property="userId" column="user_id" />
        <result property="email" column="email" />
        <result property="password" column="password" />
        <result property="nickname" column="nickname" />
        <result property="birthDate" column="birth_date" />
        <result property="postalCode" column="postal_code" />
        <result property="addressLine1" column="address_line1" />
        <result property="addressLine2" column="address_line2" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <!-- 사용자 조회 시 공통으로 사용하는 컬럼 목록 -->
    <sql id="userColumns">
        user_id,
        email,
        password,
        nickname,
        birth_date,
        postal_code,
        address_line1,
        address_line2,
        created_at,
        updated_at
    </sql>

    <!-- 신규 사용자를 저장하고 생성된 user_id를 userId 필드에 채움 -->
    <insert id="insert" parameterType="UserVO" useGeneratedKeys="true" keyProperty="userId">
        insert into users (
            email,
            password,
            nickname,
            birth_date,
            postal_code,
            address_line1,
            address_line2
        ) values (
                     #{email},
                     #{password},
                     #{nickname},
                     #{birthDate},
                     #{postalCode},
                     #{addressLine1},
                     #{addressLine2}
        )
    </insert>

    <!-- user_id로 사용자 한 명을 조회 -->
    <select id="findById" resultMap="userMap">
        select
        <include refid="userColumns" />
        from users
        where user_id = #{userId}
    </select>

    <!-- 이메일로 사용자 한 명을 조회한다. 로그인 인증에서 사용 -->
    <select id="findByEmail" resultMap="userMap">
        select
        <include refid="userColumns" />
        from users
        where email = #{email}
    </select>

    <!-- 닉네임으로 사용자 한 명을 조회 -->
    <select id="findByNickname" resultMap="userMap">
        select
        <include refid="userColumns" />
        from users
        where nickname = #{nickname}
    </select>

    <!-- 이메일 중복 여부를 확인하기 위해 같은 이메일의 사용자 수를 조회 -->
    <select id="countByEmail" resultType="int">
        select count(*)
        from users
        where email = #{email}
    </select>

    <!-- 닉네임 중복 여부를 확인하기 위해 같은 닉네임의 사용자 수를 조회 -->
    <select id="countByNickname" resultType="int">
        select count(*)
        from users
        where nickname = #{nickname}
    </select>

    <!-- 사용자 기본 정보를 수정한다. 비밀번호는 별도 쿼리에서 수정 -->
    <update id="update" parameterType="UserVO">
        update users
        set
            nickname = #{nickname},
            birth_date = #{birthDate},
            postal_code = #{postalCode},
            address_line1 = #{addressLine1},
            address_line2 = #{addressLine2},
            updated_at = current_timestamp
        where user_id = #{userId}
    </update>

    <!-- 사용자 비밀번호를 수정 -->
    <update id="updateProfile">
        update users
        set
            nickname = #{nickname},
            birth_date = #{birthDate},
            updated_at = current_timestamp
        where user_id = #{userId}
    </update>

    <update id="updatePassword" parameterType="UserVO">
        update users
        set
            password = #{password},
            updated_at = current_timestamp
        where user_id = #{userId}
    </update>

    <!-- user_id로 사용자를 삭제 -->
    <delete id="deleteById">
        delete from users
        where user_id = #{userId}
    </delete>
</mapper>
