<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.kkobi.trade.mapper.TradeStockMapper">

    <select id="findById" resultType="org.kkobi.trade.dto.TradeStockDto">
        SELECT security_id, ticker, name, market, kis_code AS kisCode
        FROM securities
        WHERE security_id = #{securityId}
    </select>

    <!--
        kis_code 컬럼에 인덱스가 없으면 풀스캔 발생.
        idx_securities_kis_code (kis_code) 인덱스 권장.
    -->
    <select id="findByKisCode" resultType="org.kkobi.trade.dto.TradeStockDto">
        SELECT security_id, ticker, name, market, kis_code AS kisCode
        FROM securities
        WHERE kis_code = #{kisCode}
    </select>

</mapper>
